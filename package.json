    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.37.1",
    "react-tilt": "^1.0.2",
    "satellite.js": "^6.0.2",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
